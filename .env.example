# Copia este fichero a ".env" (sin el .example) y rellena tus valores.
# El ".env" real NUNCA se sube a git (ya esta en .gitignore).

# Token del bot de Telegram (te lo da @BotFather). Usa un bot NUEVO,
# distinto del que se filtro en el proyecto anterior.
TELEGRAM_BOT_TOKEN=

# Tu user_id numerico de Telegram (NO el chat_id de antes). Es la
# whitelist: solo este usuario podra usar los comandos del bot.
# Para saber tu user_id, escribele a @userinfobot en Telegram.
TELEGRAM_ADMIN_ID=

# Nombre del fichero de la base de datos SQLite, dentro de datos/.
DB_FILENAME=bot.sqlite3

# true = navegador sin ventana (para la Pi y para uso normal).
# false = navegador visible (util mientras pruebas/depuras en tu PC).
HEADLESS=true

# Ollama local, para el asistente de alias de equipos.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
